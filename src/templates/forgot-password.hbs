<html>
  <head>
    <meta charset='UTF-8' />
    <title>Password Reset</title>
    <style>
      body {
        margin: 0;
        padding: 0;
        font-family: Arial, Helvetica, sans-serif;
      }

      .container {
        max-width: 600px;
        margin: auto;
        background: #111;
        border: 1px solid #2a2a2a;
      }

      .header {
        padding: 20px;
        background: #000;
        border-bottom: 3px solid #3fb34f;
      }

      .logo {
        font-size: 22px;
        font-weight: bold;
        color: #3fb34f;
      }

      .title {
        text-align: center;
        font-size: 24px;
        font-weight: bold;
        padding: 25px 20px;
        color: white;
      }

      .divider {
        height: 3px;
        background: linear-gradient(90deg, #6bd14d, #9fe06e);
      }

      .content {
        padding: 24px 20px;
        color: #cfcfcf;
        font-size: 15px;
        line-height: 1.6;
      }

      .token-box {
        margin: 20px 0;
        padding: 16px;
        background: #1a1a1a;
        border: 1px solid #3fb34f;
        border-radius: 6px;
        text-align: center;
      }

      .token-label {
        font-size: 12px;
        color: #888;
        margin-bottom: 8px;
        text-transform: uppercase;
        letter-spacing: 1px;
      }

      .token-value {
        font-size: 13px;
        font-weight: bold;
        color: #9fe06e;
        word-break: break-all;
        font-family: monospace;
      }

      .warning {
        margin-top: 16px;
        padding: 12px 16px;
        background: #1f1200;
        border-left: 3px solid #f5a623;
        border-radius: 4px;
        color: #f5a623;
        font-size: 13px;
      }

      .footer {
        padding: 20px;
        font-size: 13px;
        color: #666;
        text-align: center;
        border-top: 1px solid #2a2a2a;
      }
    </style>
  </head>

  <body>
    <div class='container'>

      <div class='header'>
        <span class='logo'>Request Management System (RMS)</span>
      </div>

      <div class='title'>
        Password Reset Request
      </div>

      <div class='divider'></div>

      <div class='content'>
        <p>Hi <strong style='color: white;'>{{name}}</strong>,</p>
        <p>We received a request to reset the password for your account. Use the token below to set a new password:</p>

        <div class='token-box'>
          <div class='token-label'>Reset Token</div>
          <div class='token-value'>{{token}}</div>
        </div>

        <div class='warning'>
          ⚠️ This token is valid for
          <strong>5 minutes</strong>
          and can only be used
          <strong>once</strong>.
        </div>

        <p style='margin-top: 20px;'>If you did not request a password reset, please ignore this email. Your password
          will remain unchanged.</p>
      </div>

      <div class='footer'>
        This is an automated email from Request Management System.<br />
        Do not reply to this email.
      </div>

    </div>
  </body>
</html>