// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Action {
  CREATE
  READ
  UPDATE
  DELETE
  MANAGE
  APPROVE
}

enum Decision {
  ALLOW
  DENY
}

//==================== USER ===================
model User {
  username  String           @id @db.Char(8)
  name      String?          @db.VarChar(100)
  email     String?          @unique @db.VarChar(254)
  password  String           @db.VarChar(255)
  isActive  Boolean          @default(true) @map("is_active")
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(0)
  createdBy String           @map("created_by") @db.Char(8)
  updatedAt DateTime?        @updatedAt @map("updated_at") @db.Timestamptz(0)
  updatedBy String?          @map("updated_by") @db.Char(8)

  userRole     UserRole[]
  userPermission  UserPermission[]

  @@map("users")
}

//==================== ROLE ===================
model Role {
  code      String           @id @db.VarChar(50) // VD: ADMIN, MANAGER
  name      String           @db.VarChar(100)
  isActive  Boolean          @default(true) @map("is_active")
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(0)
  createdBy String           @map("created_by") @db.Char(8)
  updatedAt DateTime?        @updatedAt @map("updated_at") @db.Timestamptz(0)
  updatedBy String?          @map("updated_by") @db.Char(8)

  userRole     UserRole[]
  rolePermission  RolePermission[]

  @@map("roles")
}

//==================== USER ROLE ===================
model UserRole {
  username    String @db.Char(8)
  roleCode    String @map("role_code") @db.VarChar(50)
  sectionCode String @db.Char(4)

  user        User   @relation(fields: [username], references: [username])
  role        Role   @relation(fields: [roleCode], references: [code])

  @@id([username, roleCode, sectionCode])
  @@map("user_role")
}

//==================== FEATURE ===================
model Feature {
  code      String           @id @db.VarChar(100) // VD: "CATEGORY", "ASSET", "REPORT.SALES"
  name      String           @db.VarChar(150)
  isActive  Boolean          @default(true) @map("is_active")
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(0)
  createdBy String           @map("created_by") @db.Char(8)
  updatedAt DateTime?        @updatedAt @map("updated_at") @db.Timestamptz(0)
  updatedBy String?          @map("updated_by") @db.Char(8)

  rolePermission  RolePermission[]
  userPermission  UserPermission[]

  @@map("features")
}

//==================== ROLE PERMISSIONS ===================
model RolePermission {
  roleCode    String    @map("role_code") @db.VarChar(50)
  featureCode String    @map("feature_code") @db.VarChar(100)
  action      Action
  sectionCode String   @map("section_code") @db.Char(4)
  decision    Decision
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(0)
  createdBy   String    @map("created_by") @db.Char(8)
  updatedAt   DateTime? @updatedAt @map("updated_at") @db.Timestamptz(0)
  updatedBy   String?   @map("updated_by") @db.Char(8)

  role        Role      @relation(fields: [roleCode], references: [code])
  feature     Feature   @relation(fields: [featureCode], references: [code])

  @@id([roleCode, featureCode, action, sectionCode])
  @@map("role_permission")
}

//==================== USER PERMISSIONS ===================
model UserPermission {
  username    String    @db.Char(8)
  featureCode String    @map("feature_code") @db.VarChar(100)
  action      Action
  decision    Decision
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(0)
  createdBy   String    @map("created_by") @db.Char(8)
  updatedAt   DateTime? @updatedAt @map("updated_at") @db.Timestamptz(0)
  updatedBy   String?   @map("updated_by") @db.Char(8)

  user        User      @relation(fields: [username], references: [username])
  feature     Feature   @relation(fields: [featureCode], references: [code])

  @@id([username, featureCode, action])
  @@map("user_permissions")
}
