{
  "name": "rms",
  "version": "0.0.0",
  "description": "Request Management System",
  "main": "index.js",
  "engines": {
    "node": "22.21.1"
  },
  "type": "module",
  "scripts": {
    "dev:api": "cross-env NODE_ENV=development tsx watch --inspect=0.0.0.0:9229 src/server.ts",
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "build": "tsc && tsc-alias",
    "test": "jest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "cross-env NODE_ENV=production node dist/server.js",
    "prepare": "husky",
    "commit": "cz",
    "db:migrate": "drizzle-kit migrate",
    "db:generate": "drizzle-kit generate",
    "dev:db:generate": "dotenv -e .env.development -- drizzle-kit generate",
    "dev:db:migrate": "dotenv -e .env.development -- drizzle-kit migrate",
    "dev:db:studio": "dotenv -e .env.development -- drizzle-kit studio",
    "dev:worker": "cross-env NODE_ENV=development tsx watch src/workers/worker.ts",
    "dev": "concurrently --raw \"npm run dev:api\" \"npm run dev:worker\""
  },
  "config": {
    "commitizen": {
      "path": "cz-git"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hoangloc1307/rms.git"
  },
  "author": "Tran Nguyen Hoang Loc",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/hoangloc1307/rms/issues"
  },
  "homepage": "https://github.com/hoangloc1307/rms#readme",
  "dependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@aws-sdk/client-s3": "^3.1005.0",
    "@aws-sdk/s3-request-presigner": "^3.1005.0",
    "argon2": "^0.44.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.71.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.4",
    "drizzle-orm": "^0.45.1",
    "express": "^5.1.0",
    "express-validator": "^7.2.1",
    "google-auth-library": "^10.6.1",
    "handlebars": "^4.7.8",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.0",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.17.21",
    "luxon": "^3.7.1",
    "ms": "^2.1.3",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.1",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pretty-ms": "^9.3.0",
    "rimraf": "^6.1.2",
    "swagger-ui-express": "^5.0.1",
    "tsc-alias": "^1.8.16",
    "yamljs": "^0.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@eslint/js": "^9.39.2",
    "@swc/jest": "^0.2.39",
    "@tsconfig/node-ts": "^23.6.3",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.20",
    "@types/luxon": "^3.7.1",
    "@types/ms": "^2.1.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.2",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.18.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/yamljs": "^0.2.34",
    "chalk": "^5.6.2",
    "commitizen": "^4.3.1",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "cz-git": "^1.12.0",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "lint-staged": "^16.2.7",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0"
  }
}
